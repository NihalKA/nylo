require "base64"
require "tmpdir"
require "fileutils"
def required(name)
  value = ENV[name]
  UI.user_error!("Missing #{name}; see docs/RELEASE.md") if value.to_s.empty?
  value
end

def store_key
  app_store_connect_api_key(
    key_id: required("ASC_KEY_ID"), issuer_id: required("ASC_ISSUER_ID"),
    key_content: required("ASC_KEY_P8_BASE64"), is_key_content_base64: true,
    in_house: false
  )
end

def production_gate!
  UI.user_error!("Production evidence gate is incomplete") unless ENV["NYLO_RELEASE_READY"] == "true"
end

default_platform(:ios)
platform :ios do
  desc "Build a signed iPhone candidate and upload to TestFlight"
  lane :beta do
    key = store_key
    team = required("APPLE_TEAM_ID")
    build_number = required("IOS_BUILD_NUMBER")
    profile_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    Dir.mktmpdir("nylo-signing") do |dir|
      certificate = File.join(dir, "distribution.p12")
      profile = File.join(dir, "profile.mobileprovision")
      File.binwrite(certificate, Base64.strict_decode64(required("IOS_CERT_P12_BASE64")))
      File.binwrite(profile, Base64.strict_decode64(required("IOS_PROFILE_BASE64")))
      File.chmod(0600, certificate)
      File.chmod(0600, profile)
      profile_data = sh("security", "cms", "-D", "-i", profile, log: false)
      require "plist"
      parsed = Plist.parse_xml(profile_data)
      UI.user_error!("Profile team mismatch") unless parsed["TeamIdentifier"].include?(team)
      UI.user_error!("Profile app mismatch") unless parsed.dig("Entitlements", "application-identifier") == "#{team}.com.nylohq.nylo"
      installed = File.join(profile_dir, "#{parsed.fetch('UUID')}.mobileprovision")
      keychain_name = "nylo-ci-#{build_number}.keychain-db"
      keychain_password = required("CI_KEYCHAIN_PASSWORD")
      begin
        create_keychain(name: keychain_name, password: keychain_password, default_keychain: false, unlock: true, timeout: 3600)
        import_certificate(certificate_path: certificate, certificate_password: required("IOS_CERT_PASSWORD"), keychain_name: keychain_name, keychain_password: keychain_password)
        FileUtils.mkdir_p(profile_dir)
        FileUtils.cp(profile, installed)
        sh("cd .. && node scripts/set-ios-build.mjs #{build_number}")
        sh("cd .. && npx expo prebuild --platform ios --no-install")
        sh("cd ../ios && pod install")
        build_app(workspace: "ios/Nylo.xcworkspace", scheme: "Nylo", clean: true, export_method: "app-store-connect", output_directory: "artifacts/release", output_name: "Nylo.ipa", export_options: { signingStyle: "manual", teamID: team, provisioningProfiles: { "com.nylohq.nylo" => parsed.fetch("Name") } }, xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{team} PROVISIONING_PROFILE_SPECIFIER='#{parsed.fetch('Name')}'")
        upload_to_testflight(api_key: key, ipa: "artifacts/release/Nylo.ipa", skip_waiting_for_build_processing: true, distribute_external: false)
      ensure
        FileUtils.rm_f(installed)
        delete_keychain(name: keychain_name) if File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}"))
      end
    end
  end

  desc "Submit the specifically tested TestFlight build for App Review"
  lane :submit do
    production_gate!
    upload_to_app_store(api_key: store_key, app_identifier: "com.nylohq.nylo", app_version: required("IOS_MARKETING_VERSION"), build_number: required("IOS_REVIEW_BUILD_NUMBER"), skip_binary_upload: true, skip_metadata: true, skip_screenshots: true, submit_for_review: true, automatic_release: true, force: true, run_precheck_before_submit: false)
  end
end
