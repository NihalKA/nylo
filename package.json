{
  "name": "nylo-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.142",
    "@ai-sdk/openai": "4.0.115",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "ai": "7.0.170",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "marked": "18.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "export": "expo export --platform all",
    "format:check": "prettier --check app src tests scripts plugins modules README.md app.json package.json tsconfig.json",
    "format": "prettier --write app src tests scripts plugins modules README.md app.json package.json tsconfig.json"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-image",
          "expo-image-manipulator",
          "SDWebImage",
          "SDWebImageWebPCoder",
          "expo-image-picker"
        ]
      }
    }
  }
}
